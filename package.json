{
  "name": "create-pluto",
  "type": "module",
  "version": "0.11.0",
  "description": "CLI Wizard for creating a Pluto App",
  "author": "https://github.com/ojvribeiro",
  "license": "MIT",
  "homepage": "https://github.com/plutocms/create-pluto#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plutocms/create-pluto.git"
  },
  "bugs": {
    "url": "https://github.com/plutocms/create-pluto/issues"
  },
  "keywords": [
    "pluto",
    "plutocms",
    "nuxt",
    "vue",
    "cms",
    "wordpress",
    "headless",
    "cms"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "bin": {
    "create-pluto": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "setup": "node src/index.ts",
    "build": "tsdown",
    "prepack": "tsdown",
    "prettier": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-test-module-mocks --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "giget": "^3.3.1",
    "nypm": "^0.6.12"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.2",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
